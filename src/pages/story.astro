---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { withBase, fixPublicPath } from '../utils/path';

import ipGalleryData from '../data/ip-gallery.json';
const magieImages = ipGalleryData.images.map(img => ({ ...img, src: fixPublicPath(img.src) }));
const storyHeroBg = withBase('/images/story/story-hero.webp');
---

<BaseLayout title="品牌故事">
  <Navbar />

  <!-- Hero background image — full viewport first screen, no overlay content -->
  <section class="story-hero relative overflow-hidden" style={`--story-hero-bg: url('${storyHeroBg}');`}>
  </section>

  <main class="pb-16 pt-16">
    <!-- Title section after hero -->
    <section class="py-12 px-4 text-center">
      <h1 class="font-display text-4xl md:text-6xl font-bold text-brand-green">品牌故事</h1>
      <p class="mt-4 text-lg md:text-xl text-brand-green/60 font-body">从一朵玉兰花，到一个关于美好的故事</p>
    </section>
    <!-- 缘起 -->
    <section class="py-12 px-4">
      <div class="max-w-4xl mx-auto">
        <SectionHeading title="缘起" />
        <div class="flex flex-col md:flex-row items-center gap-8 mt-8">
          <div class="w-full md:w-1/2">
            <img
              src={magieImages[0]?.src || withBase('/images/placeholders/placeholder-01.webp')}
              alt="缘起"
              class="w-full rounded-3xl shadow-sm"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-1/2 space-y-4 text-brand-green/70 font-body leading-relaxed">
            <p>春天的玉兰花，总是开得那么突然。一夜之间，满树洁白，像是谁施了魔法。</p>
            <p>我们在那个春天驻足，被这份不期而遇的美好打动。于是想，如果能把这份感动留住，让更多人"遇见兰不住的美好"，该多好。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 遇见 — text only -->
    <section class="py-12 px-4 bg-white/30">
      <div class="max-w-3xl mx-auto">
        <SectionHeading title="遇见" />
        <div class="mt-8 space-y-4 text-brand-green/70 font-body leading-relaxed text-center">
          <p>遇兰玉兰，取"遇见兰不住的美好"之意。"兰不住"是"拦不住"的谐音——那些拦不住的开心、拦不住的灵感、拦不住的想要好好生活的念头。</p>
          <p>我们相信，美好不需要刻意追寻，它就在你忙里偷闲的那一刻，悄悄绽放。</p>
        </div>
      </div>
    </section>

    <!-- magie 的诞生 — text only -->
    <section class="py-12 px-4">
      <div class="max-w-3xl mx-auto">
        <SectionHeading title="magie 的诞生" />
        <div class="mt-8 space-y-4 text-brand-green/70 font-body leading-relaxed text-center">
          <p>magie 是从玉兰花苞里蹦出来的小精灵。她圆滚滚、胖嘟嘟，总是笑嘻嘻的。</p>
          <p>有人说她像只小鸡，她才不在意呢——"胖点又怎样，开心最重要！"</p>
          <p>magie 的名字来自"magic"，因为她相信：每一天都藏着小小的魔法，只要你愿意去发现。</p>
        </div>
      </div>
    </section>

    <!-- 品牌理念 -->
    <section class="py-12 px-4 bg-brand-lavender/20">
      <div class="max-w-4xl mx-auto text-center">
        <SectionHeading title="品牌理念" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
          <div class="bg-white/60 rounded-3xl p-6 shadow-sm">
            <div class="text-4xl mb-3">🌸</div>
            <h3 class="font-heading font-bold text-brand-green mb-2">忙里偷闲</h3>
            <p class="text-sm text-brand-green/60 font-body">再忙也要给自己留一点发呆的时间</p>
          </div>
          <div class="bg-white/60 rounded-3xl p-6 shadow-sm">
            <div class="text-4xl mb-3">✨</div>
            <h3 class="font-heading font-bold text-brand-green mb-2">也发光</h3>
            <p class="text-sm text-brand-green/60 font-body">平凡日常里也有闪闪发光的瞬间</p>
          </div>
          <div class="bg-white/60 rounded-3xl p-6 shadow-sm">
            <div class="text-4xl mb-3">🐣</div>
            <h3 class="font-heading font-bold text-brand-green mb-2">做自己</h3>
            <p class="text-sm text-brand-green/60 font-body">胖点又怎样？开心最重要</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 我们的邀请 -->
    <section class="py-12 px-4">
      <div class="max-w-3xl mx-auto text-center">
        <SectionHeading title="我们的邀请" />
        <p class="text-brand-green/70 font-body leading-relaxed mt-6">
          遇兰玉兰不只是文创品牌，更是一种生活态度。我们邀请你，和magie一起，去春天，去感受春天，去成为春天。
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a href={withBase('/products')} class="px-8 py-3 rounded-full bg-brand-green text-white font-body hover:bg-brand-green/90 transition-colors">
            看看好物
          </a>
          <a href={withBase('/magie')} class="px-8 py-3 rounded-full bg-brand-gold text-white font-body hover:bg-brand-gold/90 transition-colors">
            认识 magie
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .story-hero {
    min-height: 100svh;
    background-image: var(--story-hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>