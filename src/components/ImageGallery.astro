---
export interface Props {
  images: string[];
  alt?: string;
}

const { images, alt = '图片' } = Astro.props;
---

<div class="image-gallery">
  {images.length === 1 ? (
    <div class="rounded-2xl overflow-hidden">
      <img src={images[0]} alt={alt} class="w-full object-cover" loading="lazy" />
    </div>
  ) : (
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {images.map((src, i) => (
        <div class={`rounded-2xl overflow-hidden ${i === 0 ? 'col-span-2 row-span-2' : ''}`}>
          <img src={src} alt={`${alt} ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
        </div>
      ))}
    </div>
  )}
</div>
