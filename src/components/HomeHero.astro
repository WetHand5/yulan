---
import PetalCanvas from './PetalCanvas.tsx';
import { withBase } from '../utils/path';

const heroBg = withBase('/images/home/home-hero-bg.webp');
const heroLogoBase = withBase('/images/home/home-hero-logo.webp');
const heroLogoUpper = withBase('/images/home/home-hero-logo-upper.webp');
---

<section class="home-hero relative overflow-hidden">
  <PetalCanvas client:load />

  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-[#2a3a1e]/40 z-[1]"></div>

  <!-- Centered content -->
  <div class="relative z-10 flex flex-col items-center justify-center min-h-[100svh] px-4 text-center">
    <div class="home-hero-logo relative w-[25.6rem] md:w-[32rem] lg:w-[38.4rem] mb-6">
      <img
        src={heroLogoBase}
        alt="遇兰玉兰"
        class="w-full h-auto object-contain"
      />
      <!-- Upper logo: position adjustable via CSS custom properties -->
      <img
        src={heroLogoUpper}
        alt=""
        class="home-hero-logo-upper absolute object-contain pointer-events-auto"
        style="--logo-offset-x: -52px; --logo-offset-y: -35px; --logo-scale: 0.4; left: 50%; top: 50%; transform: translate(calc(-50% + var(--logo-offset-x)), calc(-50% + var(--logo-offset-y))) scale(var(--logo-scale)); width: 80%;"
        id="hero-logo-upper"
      />
    </div>
    <p class="text-white font-body text-base md:text-xl lg:text-2xl leading-relaxed tracking-wide mb-10">
      玉见兰不住的美好，忙里偷闲也发光
    </p>

    <!-- CTA pill buttons -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href={withBase('/products')} class="group inline-flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full bg-[#435836] text-white font-body text-sm font-medium shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
        奔赴春光
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href={withBase('/magie')} class="group inline-flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full bg-[#D0CAAC] text-[#435836] font-body text-sm font-medium shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
        遇见 magie
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  .home-hero {
    min-height: 100svh;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .home-hero-logo {
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.25));
  }

  @media (max-width: 767px) {
    .home-hero-logo {
      width: 22.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-bounce {
      animation: none;
    }
  }
</style>

<script define:vars={{ heroBg }}>
  document.querySelector('.home-hero').style.setProperty('--hero-bg', `url('${heroBg}')`);

  const upperLogo = document.getElementById('hero-logo-upper');
  if (upperLogo) {
    const HOME_X = -52;
    const HOME_Y = -35;
    const HOME_SCALE = 0.4;
    let dragging = false;
    let startX = 0, startY = 0;

    // Spring physics state
    let posX = HOME_X, posY = HOME_Y;
    let velX = 0, velY = 0;
    let animId = 0;
    let springing = false;

    const SPRING_K = 0.15;   // spring stiffness
    const DAMPING = 0.7;     // damping factor
    const MASS = 1;

    upperLogo.addEventListener('mousedown', (e) => {
      dragging = true;
      springing = false;
      cancelAnimationFrame(animId);
      startX = e.clientX - posX;
      startY = e.clientY - posY;
      e.preventDefault();
    });

    // Touch support
    upperLogo.addEventListener('touchstart', (e) => {
      dragging = true;
      springing = false;
      cancelAnimationFrame(animId);
      const t = e.touches[0];
      startX = t.clientX - posX;
      startY = t.clientY - posY;
      e.preventDefault();
    }, { passive: false });

    const onMove = (cx, cy) => {
      if (!dragging) return;
      posX = cx - startX;
      posY = cy - startY;
      upperLogo.style.setProperty('--logo-offset-x', posX + 'px');
      upperLogo.style.setProperty('--logo-offset-y', posY + 'px');
    };

    window.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY));
    window.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      const t = e.touches[0];
      onMove(t.clientX, t.clientY);
    }, { passive: false });

    const startSpring = () => {
      dragging = false;
      springing = true;
      velX = (posX - HOME_X) * 0.3;
      velY = (posY - HOME_Y) * 0.3;
      springLoop();
    };

    window.addEventListener('mouseup', startSpring);
    window.addEventListener('touchend', startSpring);

    const springLoop = () => {
      const dx = posX - HOME_X;
      const dy = posY - HOME_Y;

      // Spring force: F = -k * displacement
      const fx = -SPRING_K * dx;
      const fy = -SPRING_K * dy;

      // Update velocity: v += F / m
      velX = (velX + fx / MASS) * DAMPING;
      velY = (velY + fy / MASS) * DAMPING;

      // Update position
      posX += velX;
      posY += velY;

      upperLogo.style.setProperty('--logo-offset-x', posX + 'px');
      upperLogo.style.setProperty('--logo-offset-y', posY + 'px');

      // Stop when close enough and nearly still
      if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5 && Math.abs(velX) < 0.1 && Math.abs(velY) < 0.1) {
        posX = HOME_X;
        posY = HOME_Y;
        upperLogo.style.setProperty('--logo-offset-x', posX + 'px');
        upperLogo.style.setProperty('--logo-offset-y', posY + 'px');
        springing = false;
        return;
      }

      animId = requestAnimationFrame(springLoop);
    };
  }
</script>
