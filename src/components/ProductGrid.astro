---
import ProductCard from './ProductCard.astro';

export interface Props {
  products: Array<{
    id: string;
    name: string;
    category: string;
    price: number;
    cover: string;
    tagline: string;
  }>;
}

const { products } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {products.map(p => (
    <ProductCard {...p} />
  ))}
</div>
