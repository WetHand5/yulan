---
import { withBase } from '../utils/path';

const navLinks = [
  { href: '/story', label: '品牌故事' },
  { href: '/magie', label: '遇见magie' },
  { href: '/products', label: '春日好物' },
  { href: '/checkin', label: '玉兰打卡' },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent" data-hero-dark="false">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href={withBase('/')} class="flex items-center gap-2 group shrink-0">
      <img id="nav-logo" src={withBase('/images/logo/logo.png')} alt="遇兰玉兰" class="h-8 w-auto object-contain group-hover:scale-105 transition-transform duration-300" />
    </a>

    <ul class="hidden md:flex items-center gap-1" id="nav-links-desktop">
      {navLinks.map(link => (
        <li>
          <a href={withBase(link.href)} class="nav-link relative px-3.5 py-2 text-sm font-body text-brand-green/75 hover:text-brand-gold transition-colors duration-200 rounded-lg hover:bg-white/40">
            {link.label}
          </a>
        </li>
      ))}
      <li class="ml-1">
        <a href={withBase('/cart')} class="nav-link relative inline-flex items-center p-2 text-brand-green/75 hover:text-brand-gold transition-colors rounded-lg hover:bg-white/40" id="cart-link-desktop" aria-label="购物车">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
          </svg>
          <span id="cart-count-desktop" class="absolute -top-0.5 -right-0.5 bg-brand-gold text-white text-[10px] font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center px-1 hidden">0</span>
        </a>
      </li>
    </ul>

    <button id="mobile-menu-btn" class="md:hidden p-2 text-brand-green rounded-lg hover:bg-white/40 transition-colors" aria-label="菜单">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="md:hidden hidden bg-brand-bg/95 backdrop-blur-md border-t border-brand-light-green/30">
    <ul class="px-4 py-3 space-y-1">
      <li>
        <a href={withBase('/')} class="block py-2 px-3 text-sm font-body text-brand-green/75 hover:text-brand-gold rounded-lg hover:bg-white/40 transition-colors">
          首页
        </a>
      </li>
      {navLinks.map(link => (
        <li>
          <a href={withBase(link.href)} class="block py-2 px-3 text-sm font-body text-brand-green/75 hover:text-brand-gold rounded-lg hover:bg-white/40 transition-colors">
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={withBase('/cart')} class="block py-2 px-3 text-sm font-body text-brand-green/75 hover:text-brand-gold rounded-lg hover:bg-white/40 transition-colors">
          购物车
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => menu?.classList.add('hidden'));
  });

  const navbar = document.getElementById('navbar');
  const navLogo = document.getElementById('nav-logo');
  const isHomePage = window.location.pathname === '/' || window.location.pathname === '/yulan/' || window.location.pathname === '/yulan';

  function updateNavbar() {
    const scrolled = window.scrollY > 20;

    if (scrolled) {
      navbar?.classList.add('bg-brand-bg/80', 'backdrop-blur-md', 'shadow-sm');
      navbar?.classList.remove('navbar-hero-dark');
      navbar?.setAttribute('data-hero-dark', 'false');
      if (isHomePage && navLogo) {
        navLogo.src = navLogo.src.replace('logo-white.webp', 'logo.png').replace('logo-white.png', 'logo.png');
      }
      // Reset nav links to dark text
      document.querySelectorAll('.nav-link').forEach(el => {
        el.classList.remove('text-white/80', 'hover:text-white');
        el.classList.add('text-brand-green/75', 'hover:text-brand-gold');
      });
      // Reset mobile menu button
      const mobileBtn = document.getElementById('mobile-menu-btn');
      mobileBtn?.classList.remove('text-white');
      mobileBtn?.classList.add('text-brand-green');
    } else if (isHomePage) {
      navbar?.classList.remove('bg-brand-bg/80', 'backdrop-blur-md', 'shadow-sm');
      navbar?.classList.add('navbar-hero-dark');
      navbar?.setAttribute('data-hero-dark', 'true');
      if (navLogo) {
        navLogo.src = navLogo.src.replace('logo.png', 'logo-white.webp');
      }
      // White nav links for dark hero
      document.querySelectorAll('.nav-link').forEach(el => {
        el.classList.remove('text-brand-green/75', 'hover:text-brand-gold');
        el.classList.add('text-white/80', 'hover:text-white');
      });
      // White mobile menu button
      const mobileBtn = document.getElementById('mobile-menu-btn');
      mobileBtn?.classList.remove('text-brand-green');
      mobileBtn?.classList.add('text-white');
    }
  }

  updateNavbar();
  window.addEventListener('scroll', updateNavbar, { passive: true });

  function updateCartCount() {
    try {
      const cart = JSON.parse(localStorage.getItem('yulan-cart') || '[]');
      const count = cart.reduce((sum: number, item: { quantity: number }) => sum + item.quantity, 0);
      const badge = document.getElementById('cart-count-desktop');
      if (badge) {
        badge.textContent = String(count);
        badge.classList.toggle('hidden', count === 0);
      }
    } catch {}
  }

  updateCartCount();
  window.addEventListener('cart-updated', updateCartCount);
  document.addEventListener('DOMContentLoaded', updateCartCount);
</script>

<style>
  .navbar-hero-dark #mobile-menu {
    background: rgba(42, 58, 30, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .navbar-hero-dark #mobile-menu a {
    color: rgba(255, 255, 255, 0.8);
  }
  .navbar-hero-dark #mobile-menu a:hover {
    color: white;
    background: rgba(255, 255, 255, 0.1);
  }
</style>
