---
import { withBase } from '../utils/path';
import productsData from '../data/products.json';

const featured = productsData.slice(0, 4);

/**
 * products.json 中的 cover 字段带 /public 前缀，
 * 浏览器访问时需要去掉 /public 部分。
 */
function fixImagePath(path: string): string {
  const clean = (path || '').replace(/^\/public/, '');
  return withBase(clean);
}
---

<section class="py-16 md:py-20 px-4 bg-white/40">
  <div class="max-w-6xl mx-auto">
    <!-- Heading -->
    <div class="text-center mb-10">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-brand-green mb-2">
        春日好物，正在发芽
      </h2>
      <p class="text-sm text-brand-green/50 font-body">
        精选春日文创，把美好带回家
      </p>
    </div>

    <!-- Product grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {featured.map((p) => (
        <a
          href={withBase(`/products/${p.id}`)}
          class="group rounded-3xl overflow-hidden bg-white/70 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300"
        >
          <!-- Image area -->
          <div class="aspect-square bg-brand-fresh-green/20 overflow-hidden">
            <img
              src={fixImagePath(p.cover)}
              alt={p.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Info -->
          <div class="p-3 md:p-4">
            <span class="text-[10px] md:text-xs text-brand-green/40 font-body">{p.category}</span>
            <h3 class="font-heading text-sm md:text-base font-bold text-brand-green leading-snug mt-0.5">
              {p.name}
            </h3>
            <p class="text-xs text-brand-green/50 font-body mt-1 line-clamp-2">
              {p.description}
            </p>
            <p class="text-sm md:text-base font-bold text-brand-gold mt-2">
              ¥{p.price}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- View all -->
    <div class="text-center mt-8">
      <a
        href={withBase('/products')}
        class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-full bg-brand-green/10 text-brand-green font-body text-sm hover:bg-brand-green/20 transition-colors"
      >
        查看全部好物
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>
