---
export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="text-center mb-12">
  <h2 class="font-heading text-3xl md:text-4xl font-bold text-brand-green">{title}</h2>
  {subtitle && (
    <p class="mt-3 text-brand-green/60 text-lg font-body">{subtitle}</p>
  )}
  <div class="mt-4 mx-auto w-16 h-1 bg-brand-gold rounded-full"></div>
</div>
