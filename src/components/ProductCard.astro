---
export interface Props {
  id: string;
  name: string;
  category: string;
  price: number;
  cover: string;
  tagline: string;
}

const { id, name, category, price, cover, tagline } = Astro.props;
---

<article class="group bg-white/60 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
  <a href={`/products/${id}`} class="block">
    <div class="aspect-square overflow-hidden bg-brand-fresh-green/20">
      <img
        src={cover}
        alt={name}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  </a>
  <div class="p-4">
    <span class="inline-block text-xs px-2 py-0.5 rounded-full bg-brand-fresh-green/40 text-brand-green/70 mb-2">{category}</span>
    <h3 class="font-heading text-lg font-bold text-brand-green">{name}</h3>
    <p class="text-sm text-brand-green/60 mt-1 line-clamp-2">{tagline}</p>
    <div class="mt-3 flex items-center justify-between">
      <span class="font-heading text-xl font-bold text-brand-gold">&yen;{price}</span>
      <button
        class="add-to-cart-btn text-sm px-4 py-2 rounded-full bg-brand-green text-white hover:bg-brand-green/90 transition-colors"
        data-product-id={id}
        data-product-name={name}
        data-product-price={price}
      >
        加入购物车
      </button>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const el = e.currentTarget as HTMLElement;
      const id = el.dataset.productId!;
      const name = el.dataset.productName!;
      const price = Number(el.dataset.productPrice!);

      let cart: Array<{ id: string; name: string; price: number; quantity: number }> = [];
      try {
        cart = JSON.parse(localStorage.getItem('yulan-cart') || '[]');
      } catch {}

      const existing = cart.find(item => item.id === id);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ id, name, price, quantity: 1 });
      }

      localStorage.setItem('yulan-cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart-updated'));

      // Brief visual feedback
      const original = el.textContent;
      el.textContent = '已添加 ✓';
      setTimeout(() => { el.textContent = original; }, 1000);
    });
  });
</script>
